#include <Wire.h>
#include <MPU9250_asukiaaa.h>

MPU9250_asukiaaa mySensor;

float X_min = 55.08, X_max = 195.70;
float Y_min = -122.28, Y_max = 27.04;

void setup() {
  Serial.begin(115200);
  while (!Serial);

  Wire.begin();
  mySensor.setWire(&Wire);
  mySensor.beginMag();

  Serial.println("Sensor initialisiert mit Kalibrierung!");
}

void loop() {
  mySensor.magUpdate();

  // Rohdaten lesen
  float magX_raw = mySensor.magX();
  float magY_raw = mySensor.magY();

  // Kalibrierte Daten berechnen
  float magX = (magX_raw - (X_min + X_max) / 2) / ((X_max - X_min) / 2);
  float magY = (magY_raw - (Y_min + Y_max) / 2) / ((Y_max - Y_min) / 2);

  // Richtung (Heading) berechnen
  float heading = atan2(magY, magX) * (180.0 / M_PI);
  if (heading < 0) {
    heading += 360.0;
  }

  // Ausgabe der Richtung
  Serial.print("Richtung: ");
  Serial.print(heading);
  Serial.println("°");

  delay(500);
}
