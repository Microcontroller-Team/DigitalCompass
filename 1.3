#include <Wire.h>
#include <MPU9250_asukiaaa.h>
#include <EEPROM.h>

// EEPROM memory addresses for calibration data
#define X_MIN_ADDR 0
#define X_MAX_ADDR 4
#define Y_MIN_ADDR 8
#define Y_MAX_ADDR 12

// Pin definitions
const int BUTTON_PIN = 2;

// Timing constants
const unsigned long BUTTON_HOLD_TIME = 5000;   // 5 seconds
const unsigned long CALIBRATION_TIME = 30000; // 30 seconds

// Global variables
MPU9250_asukiaaa mpu;
float X_min, X_max, Y_min, Y_max;
float X_mid, X_scale, Y_mid, Y_scale;

bool buttonPressed = false;
bool calibrating = false;
unsigned long buttonPressStart = 0;
unsigned long calibrationStartTime = 0;

void setup() {
  Serial.begin(115200);

  // Load calibration data from EEPROM
  loadCalibrationValues();

  // Initialize MPU9250 sensor
  Wire.begin();
  mpu.setWire(&Wire);
  mpu.beginMag();
  Serial.println("Sensor initialized with calibration!");

  // Initialize button pin
  pinMode(BUTTON_PIN, INPUT);
  digitalWrite(BUTTON_PIN, LOW); // Ensure the pin is initially LOW
}

void loop() {
  handleButtonPress();

  if (calibrating) {
    performCalibration();
  } else {
    displayHeading();
  }
}

/**
 * Handles button press logic to detect if the button is held for the required time.
 */
void handleButtonPress() {
  int buttonState = digitalRead(BUTTON_PIN);

  if (buttonState == HIGH) {
    if (!buttonPressed) {
      buttonPressStart = millis();
      buttonPressed = true;
    } else if (millis() - buttonPressStart >= BUTTON_HOLD_TIME && !calibrating) {
      Serial.println("Button held for 5 seconds. Starting calibration...");
      calibrating = true;
      calibrationStartTime = millis();
      resetCalibrationValues();
    }
  } else {
    buttonPressed = false; // Reset if the button is released
  }
}

/**
 * Resets calibration values to their initial extreme values.
 */
void resetCalibrationValues() {
  X_min = 1e6;
  X_max = -1e6;
  Y_min = 1e6;
  Y_max = -1e6;
}

/**
 * Updates calibration values based on the current sensor readings.
 */
void performCalibration() {
  mpu.magUpdate();

  float magX = mpu.magX();
  float magY = mpu.magY();

  // Update calibration ranges
  X_min = min(X_min, magX);
  X_max = max(X_max, magX);
  Y_min = min(Y_min, magY);
  Y_max = max(Y_max, magY);

  // Display current calibration progress
  Serial.print("Calibrating... X_min: ");
  Serial.print(X_min);
  Serial.print(", X_max: ");
  Serial.print(X_max);
  Serial.print(", Y_min: ");
  Serial.print(Y_min);
  Serial.print(", Y_max: ");
  Serial.println(Y_max);

  // Check if calibration time has elapsed
  if (millis() - calibrationStartTime >= CALIBRATION_TIME) {
    Serial.println("Calibration completed. Saving values...");
    saveCalibrationValues();
    calibrating = false;
  }
}

/**
 * Displays the current heading calculated from the sensor readings.
 */
void displayHeading() {
  mpu.magUpdate();

  float magX_raw = mpu.magX();
  float magY_raw = mpu.magY();

  // Use precomputed values for normalization
  float magX = (magX_raw - X_mid) / X_scale;
  float magY = (magY_raw - Y_mid) / Y_scale;

  // Calculate and display heading
  float heading = atan2(magY, magX) * (180.0 / M_PI);
  if (heading < 0) {
    heading += 360.0;
  }

  Serial.print("Heading: ");
  Serial.print(heading);
  Serial.println("°");

  delay(500); // update rate
}

/**
 * Loads calibration values from EEPROM. Sets default values if EEPROM is empty.
 */
void loadCalibrationValues() {
  EEPROM.get(X_MIN_ADDR, X_min);
  EEPROM.get(X_MAX_ADDR, X_max);
  EEPROM.get(Y_MIN_ADDR, Y_min);
  EEPROM.get(Y_MAX_ADDR, Y_max);

  if (isnan(X_min) || isnan(X_max) || isnan(Y_min) || isnan(Y_max)) {
    Serial.println("EEPROM is empty. Setting default values.");
    X_min = -100;
    X_max = 100;
    Y_min = -100;
    Y_max = 100;
    saveCalibrationValues();
  } else {
    // Update derived values after loading
    updateCalibrationDerivedValues();
  }
}

/**
 * Saves the current calibration values to EEPROM and updates derived values.
 */
void saveCalibrationValues() {
  EEPROM.put(X_MIN_ADDR, X_min);
  EEPROM.put(X_MAX_ADDR, X_max);
  EEPROM.put(Y_MIN_ADDR, Y_min);
  EEPROM.put(Y_MAX_ADDR, Y_max);

  // Update derived values after saving
  updateCalibrationDerivedValues();

  Serial.println("Calibration values saved successfully!");
}

/**
 * Updates derived calibration values (midpoint and scale) for normalization.
 */
void updateCalibrationDerivedValues() {
  X_mid = (X_min + X_max) / 2;
  X_scale = (X_max - X_min) / 2;
  Y_mid = (Y_min + Y_max) / 2;
  Y_scale = (Y_max - Y_min) / 2;

  // Prevent division by zero in case of invalid calibration
  if (X_scale == 0) X_scale = 1;
  if (Y_scale == 0) Y_scale = 1;
}
